diff --git a/prime_core/configs/prime.yaml b/prime_core/configs/prime.yaml
index dea6048..c08ca4e 100644
--- a/prime_core/configs/prime.yaml
+++ b/prime_core/configs/prime.yaml
@@ -45,6 +45,13 @@ processed_sfreq: 1000  # QC + model window (PRIME input). Needs retraining to ch
 ica_sfreq: 1000        # calibration ICA window (fit + ICLabel)
 post_sfreq: 5000       # post-stimulus window, calibration and every pulse
 
+# --- Post-stimulus low-pass (zero-phase FIR, applied right after the first artifact blank) ---
+# Designed once in Preprocessor.calibrate() from these two numbers and post_sfreq, then frozen in
+# the calibration bundle: replay and every live pulse use the bundle, never this file.
+# Not applied (RuntimeWarning) if post_lowpass_hz >= post_sfreq / 2, e.g. at post_sfreq 1000.
+post_lowpass_hz: 500           # null / 0 = off
+post_lowpass_halfwidth_ms: 5   # reach on each side; 5 ms = 51 taps at 5 kHz
+
 # --- Dipole sub-window search (seconds; converted with post_sfreq) ---
 dipole_min_window: 0.003   # was min_window_size=3 samples at 1 kHz
 dipole_max_window: 0.006   # was max_window_size=6 samples at 1 kHz
