+def get_post_lowpass() -> tuple[float | None, float]:
+    """(cutoff in Hz or None = off, half-width in ms) of the post-stimulus low-pass.
+
+    Missing keys mean "off", so an older prime.yaml behaves exactly as before.
+    """
+    cfg = load_prime_config()
+    hz = cfg.get("post_lowpass_hz", None)
+    return (float(hz) if hz else None), float(cfg.get("post_lowpass_halfwidth_ms", 5.0))
+
+
